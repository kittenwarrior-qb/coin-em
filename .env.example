# Backend Environment Variables
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DEBUG_ROLE_PICKER=false

# Frontend Environment Variables
VITE_API_URL=http://localhost:3001
VITE_DEBUG_ROLE_PICKER=false

# Production primary storage (Compose defaults to its private redis service)
# Override REDIS_HOST / REDIS_PORT only for your chosen environment.

# Lightweight first-party admin analytics only; no third-party tracker.
# Provision an EmCoin password hash offline using be/src/admin/AdminAuth.ts.
# Never use a Gmail password or commit a real secret. Empty hash disables login.
EMCOIN_ADMIN_PASSWORD_HASH=
EMCOIN_ADMIN_ORIGIN=https://emcoin.cloud

# Catalog metadata only; images are separate public media assets.
# Default inside the existing backend persistent data volume. No new DB container.
EMCOIN_CATALOG_DB=data/catalog.sqlite
